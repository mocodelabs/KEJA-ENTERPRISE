NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key — server-only, never expose to the client. Used by
# src/lib/supabase/service.ts for the payment webhooks (app/api/webhooks/*),
# which run without a logged-in user session and so must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stubbed integrations (see lib/services) ---
# SMS provider (Africa's Talking) - leave unset to use the console/log stub provider
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# Payment gateway (M-Pesa Daraja) - leave unset to use the manual/console stub provider
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Email provider (Resend) - leave unset to use the console/log stub provider.
# Used to email quotes/credit notes (and any future document) with a PDF attached.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
